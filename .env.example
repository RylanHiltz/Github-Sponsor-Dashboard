
# --- EXAMPLE .ENV FILE ---

# Github Personal Access Token
PAT=your_github_pat_here

# Optional alias for PAT (supported by the code as well)
# GITHUB_TOKEN=your_github_token_here

# Optional but recommended (helps GitHub identify requests)
GITHUB_USER_AGENT=Github-Sponsor-Dashboard

# --- GitHub OAuth App (user token; avoids manual PAT rotation) ---
# Create a GitHub *OAuth App* (NOT a GitHub App).
# Note: Classic OAuth Apps typically issue long-lived access tokens (no refresh token).
# If the token is revoked/invalidated, just re-run the browser flow at /api/oauth/login.
# Set the callback URL to: http://127.0.0.1:5000/api/oauth/callback (or your deployed URL)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional override (defaults to /api/oauth/callback on the running backend)
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/oauth/callback
# Oauth Scopes for Sponsor GraphQL retrieval 
GITHUB_OAUTH_SCOPES=read:user,read:org,user:email
# Optional safety: if set, the backend will only accept OAuth tokens for this GitHub username
# (prevents someone else authorizing your public /api/oauth/login endpoint and overwriting your token cache).
# GITHUB_OAUTH_ALLOWED_LOGIN=your-github-username

# Optional hardening: if set, /api/oauth/login and /api/oauth/status will require a secret.
# This prevents random visitors from even starting the OAuth flow on a public deployment.
# Provide it as query param: /api/oauth/login?secret=... (or header: X-GitHub-OAuth-Login-Secret)
# GITHUB_OAUTH_LOGIN_SECRET=change-me
# Where to store the token JSON (default: .github-oauth-token.json in repo root)
# GITHUB_OAUTH_TOKEN_PATH=.github-oauth-token.json

# Sponsors crawling behavior
# If true, attempts to include private sponsorships in GraphQL queries. This is often
# restricted (FORBIDDEN) for non-owner viewers, so default is false.
# GITHUB_SPONSORS_INCLUDE_PRIVATE=false

# Flask session secret (required for OAuth state)
FLASK_SECRET_KEY=change-me

# Database Sensitive Info
host=your_db_host
port=your_db_port
user=your_db_user
password=your_db_password
dbname=your_db_name

# Email for OpenStreetMap Header (Part of TOS: to identify the application and its user)
email=your_email@example.com

# OpenAI API Key (Gender Inference)
API_KEY=your_openai_api_key

# GitHub username and password for authentication token
# (pronouns arent visible unless signed into a github user)
# - MAKE SURE USER DOES NOT HAVE 2FA OR PASSKEY LOGIN 
gh_username=your_github_username
gh_password=your_github_password
